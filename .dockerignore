# Exclude version control, local virtual environments, and caches
.git
.github
.venv
venv
__pycache__
*.py[cod]
.pytest_cache
.coverage
htmlcov

# Exclude all local secrets, keys, credentials, and Terraform state
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*credentials*.json
*service-account*.json
terraform/.terraform
terraform/*.tfstate*
terraform/*.tfvars
*.tfplan
tfplan
