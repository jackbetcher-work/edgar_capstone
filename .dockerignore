# Exclude version control, local virtual environments, node_modules, and caches
.git
.github
.venv
venv
__pycache__
*.py[cod]
.pytest_cache
.ruff_cache
.coverage
htmlcov
node_modules
frontend/node_modules
frontend/dist

# Exclude all local secrets, keys, credentials, and Terraform state
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*credentials*.json
*service-account*.json
terraform/.terraform
terraform/*.tfstate*
terraform/*.tfvars
*.tfplan
tfplan

# Exclude gitignored heavyweight corpus artifacts from the build context. They are
# served from BigQuery / Vertex AI Search / GCS in Cloud Run, or hydrated at startup
# via EDGAR_CORPUS_HYDRATION for offline container smoke tests.
data/curated_dataset/unstructured
data/curated_dataset/structured
data/curated_dataset/vector_search
data/curated_dataset/manifests/bigquery_filing_chunks.jsonl
data/curated_dataset/manifests/vertex_ai_search_metadata.jsonl
*.egg-info
