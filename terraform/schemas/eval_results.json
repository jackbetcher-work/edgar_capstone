[
  {"name": "run_id", "type": "STRING", "mode": "REQUIRED", "description": "Unique eval run identifier (insertId deduplication key)"},
  {"name": "recorded_at", "type": "TIMESTAMP", "mode": "REQUIRED", "description": "UTC time the run finished"},
  {"name": "started_at", "type": "TIMESTAMP", "mode": "NULLABLE", "description": "UTC time the run started"},
  {"name": "eval_mode", "type": "STRING", "mode": "REQUIRED", "description": "deterministic | live"},
  {"name": "passed", "type": "BOOLEAN", "mode": "REQUIRED", "description": "True when every regression gate passed"},
  {"name": "regressions", "type": "STRING", "mode": "REPEATED", "description": "Names of failed gates"},
  {"name": "commit_sha", "type": "STRING", "mode": "NULLABLE", "description": "Git commit evaluated (COMMIT_SHA / GITHUB_SHA / git HEAD)"},
  {"name": "environment", "type": "STRING", "mode": "NULLABLE", "description": "local | cloud_build | github_actions"},
  {"name": "dataset_source", "type": "STRING", "mode": "NULLABLE", "description": "Golden JSONL path or bigquery:<table>"},
  {"name": "dataset_version", "type": "STRING", "mode": "NULLABLE", "description": "Content hash of the golden items evaluated"},
  {"name": "corpus_kind", "type": "STRING", "mode": "NULLABLE", "description": "synthetic | hydrated | gcp"},
  {"name": "analyst_model", "type": "STRING", "mode": "NULLABLE", "description": "Financial reasoning model"},
  {"name": "judge_model", "type": "STRING", "mode": "NULLABLE", "description": "LLM-as-a-Judge model"},
  {"name": "item_count", "type": "INTEGER", "mode": "NULLABLE"},
  {"name": "items_passed", "type": "INTEGER", "mode": "NULLABLE"},
  {"name": "numeric_agreement", "type": "FLOAT", "mode": "NULLABLE", "description": "Share of scored items with 100% numeric agreement"},
  {"name": "citation_coverage", "type": "FLOAT", "mode": "NULLABLE", "description": "Share of scored items with complete inline citation coverage"},
  {"name": "grounding_recall", "type": "FLOAT", "mode": "NULLABLE", "description": "Expected sources retrieved and cited / expected sources"},
  {"name": "routing_accuracy", "type": "FLOAT", "mode": "NULLABLE", "description": "Share of scored items with correct intent, tickers, and fiscal window"},
  {"name": "judge_faithfulness", "type": "FLOAT", "mode": "NULLABLE"},
  {"name": "judge_explanation_quality", "type": "FLOAT", "mode": "NULLABLE"},
  {"name": "judge_thematic_consistency", "type": "FLOAT", "mode": "NULLABLE"},
  {"name": "safety_compliance", "type": "FLOAT", "mode": "NULLABLE", "description": "Share of red-team prompts blocked"},
  {"name": "p95_ttft_ms", "type": "FLOAT", "mode": "NULLABLE", "description": "p95 time-to-first-token (live mode only)"},
  {"name": "p95_total_latency_ms", "type": "FLOAT", "mode": "NULLABLE"},
  {"name": "item_pass_rate", "type": "FLOAT", "mode": "NULLABLE"},
  {
    "name": "gates",
    "type": "RECORD",
    "mode": "REPEATED",
    "description": "Gate evaluations against evals/thresholds.yaml",
    "fields": [
      {"name": "name", "type": "STRING", "mode": "REQUIRED"},
      {"name": "value", "type": "FLOAT", "mode": "NULLABLE"},
      {"name": "threshold", "type": "FLOAT", "mode": "NULLABLE"},
      {"name": "comparator", "type": "STRING", "mode": "NULLABLE"},
      {"name": "passed", "type": "BOOLEAN", "mode": "NULLABLE"},
      {"name": "skipped", "type": "BOOLEAN", "mode": "NULLABLE"},
      {"name": "detail", "type": "STRING", "mode": "NULLABLE"}
    ]
  },
  {
    "name": "item_results",
    "type": "RECORD",
    "mode": "REPEATED",
    "description": "Per golden item outcome",
    "fields": [
      {"name": "item_id", "type": "STRING", "mode": "REQUIRED"},
      {"name": "category", "type": "STRING", "mode": "NULLABLE"},
      {"name": "passed", "type": "BOOLEAN", "mode": "NULLABLE"},
      {"name": "status", "type": "STRING", "mode": "NULLABLE"},
      {"name": "intent", "type": "STRING", "mode": "NULLABLE"},
      {"name": "numeric_agreement", "type": "BOOLEAN", "mode": "NULLABLE"},
      {"name": "citation_coverage", "type": "BOOLEAN", "mode": "NULLABLE"},
      {"name": "routing_ok", "type": "BOOLEAN", "mode": "NULLABLE"},
      {"name": "grounding_recall", "type": "FLOAT", "mode": "NULLABLE"},
      {"name": "faithfulness_score", "type": "FLOAT", "mode": "NULLABLE"},
      {"name": "explanation_quality_score", "type": "FLOAT", "mode": "NULLABLE"},
      {"name": "thematic_consistency_score", "type": "FLOAT", "mode": "NULLABLE"},
      {"name": "judge_grade", "type": "STRING", "mode": "NULLABLE"},
      {"name": "safety_blocked", "type": "BOOLEAN", "mode": "NULLABLE"},
      {"name": "ttft_ms", "type": "FLOAT", "mode": "NULLABLE"},
      {"name": "total_latency_ms", "type": "FLOAT", "mode": "NULLABLE"},
      {"name": "failure_reasons", "type": "STRING", "mode": "REPEATED"}
    ]
  },
  {"name": "duration_seconds", "type": "FLOAT", "mode": "NULLABLE"},
  {"name": "runner_host", "type": "STRING", "mode": "NULLABLE"}
]
