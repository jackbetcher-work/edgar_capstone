project_id                      = "iron-radio-514217-q7"
project_name                    = "fde-sec-edgar-sandbox-dev"
region                          = "us-central1"
dataset_id                      = "sec_edgar"
sec_corpus_bucket               = "fde-sec-edgar-sandbox-dev-sec-corpus"
create_sec_corpus_bucket        = true
sec_corpus_bucket_versioning    = true
vertex_connection_id            = "vertex-ai-rag-conn"
analyst_service_account_id      = "sec-analyst-sa"
create_analyst_service_account  = true
create_agent_service_accounts   = true
seed_native_financial_metrics    = false
seed_native_filing_chunks        = false
seed_vertex_vector_index         = true
embedding_model                  = "text-embedding-005"
embedding_dimensions             = 768
enable_vertex_vector_search      = true
enable_vertex_ai_search          = true
artifact_registry_repo_id        = "sec-edgar-repo"
cloud_run_service_name           = "sec-edgar-analyst"
enable_cloud_run_service         = true
cloud_run_initial_image          = "us-docker.pkg.dev/cloudrun/container/hello"
seed_placeholder_secret_versions = false
cicd_service_account_id         = "sec-edgar-cicd-sa"
github_repository               = "jackbetcher-work/edgar_capstone"
deletion_protection             = false
enable_iap_backend_service      = true
allowed_workspace_domains       = []
okta_issuer_uri                 = ""
okta_client_id                  = ""
iap_authorized_principals       = []
cloud_identity_domain           = "fde-workspace.corp"
cloud_identity_customer_id      = ""
manage_cloud_identity_groups    = false
enable_cloud_identity_group_iam = false
cloud_identity_rbac_groups = {
  admins   = ["sec-edgar-admins@fde-workspace.corp"]
  analysts = ["sec-edgar-analysts@fde-workspace.corp"]
  viewers  = ["sec-edgar-viewers@fde-workspace.corp"]
}

# Cloud Build triggers (see cloudbuild.tf for the one-time GitHub App + token setup)
enable_cloudbuild_trigger                    = false
enable_cloudbuild_pr_trigger                 = true
create_cloudbuild_github_connection          = true
cloudbuild_github_connection_name            = "sec-edgar-github"
cloudbuild_github_app_installation_id        = 0
cloudbuild_github_oauth_token_secret_id      = "sec-edgar-github-oauth-token"
cloudbuild_github_oauth_token_secret_version = "1"
cloudbuild_trigger_branch_regex              = "^main$"
cloudbuild_service_account_id                = "sec-edgar-cloudbuild-sa"
