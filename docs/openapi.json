        ],
        "summary": "Admin Rbac Governance Policies",
        "description": "Administrative endpoint restricted strictly to Cloud Identity `admin` group principals.",
        "operationId": "admin_rbac_governance_policies_api_v1_admin_rbac_policies_get",
        "responses": {
          "200": {
            "description": "Successful Response",
