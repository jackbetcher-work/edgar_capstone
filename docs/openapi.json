{
  "openapi": "3.1.0",
  "info": {
    "title": "SEC EDGAR Natural Language Analyst API",
    "description": "Cloud Run FastAPI backend for deterministic SEC 10-K financial variance calculations, metadata-filtered Hybrid RAG search, and ADK agent orchestration. Internal APIs are protected via Identity-Aware Proxy (IAP) and Google Workspace Okta/SSO JWT Bearer authentication.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health",
        "description": "Cloud Run external health check and readiness probe endpoint.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/config": {
      "get": {
        "tags": [
          "Authentication & RBAC"
        ],
        "summary": "Auth Discovery Config",
        "description": "Return public SSO, IAP, Cloud Identity RBAC, and Agent Identity metadata (no secrets).",
        "operationId": "auth_discovery_config_api_v1_auth_config_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Auth Discovery Config Api V1 Auth Config Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/sso/exchange": {
      "post": {
        "tags": [
          "Authentication & RBAC"
        ],
        "summary": "Exchange Sso Id Token",
        "description": "Validate a Google Workspace / Okta SSO / IAP OIDC ID token for API Bearer access.",
