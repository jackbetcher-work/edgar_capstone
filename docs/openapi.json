                  "type": "object",
                  "title": "Response Get Authenticated Session Api V1 Auth Me Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "Authentication & RBAC"
        ],
        "summary": "Logout Authenticated Session",
        "description": "Revoke the active Bearer JWT and record a session logout audit event.",
        "operationId": "logout_authenticated_session_api_v1_auth_logout_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Logout Authenticated Session Api V1 Auth Logout Post"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/audit": {
      "get": {
        "tags": [
          "Authentication & RBAC"
        ],
        "summary": "List Security Audit Trail",
        "description": "Retrieve structured authentication and 10-K report access audit logs.",
